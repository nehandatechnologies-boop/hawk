# HAWKTRACE — environment variables
#
# Lovable Cloud (auth) values are auto-provisioned in .env.
# Set the value below per-deployment to wire HAWKTRACE into your
# Replit-hosted FastAPI backend.

# ---------------------------------------------------------------------------
# REQUIRED — HAWKTRACE tracking backend (FastAPI on Replit or elsewhere)
# ---------------------------------------------------------------------------
# Every call from src/services/api.ts is sent to this base URL.
# Requests carry the Supabase access token as `Authorization: Bearer <jwt>`.
# Validate it on your backend against the Supabase JWKS:
#   issuer  = ${VITE_SUPABASE_URL}/auth/v1
#   jwks    = ${VITE_SUPABASE_URL}/auth/v1/.well-known/jwks.json
#
# Full REST contract: see BACKEND_CONTRACT.md
#
# Example: VITE_API_BASE_URL=https://hawktrace-api.yourname.repl.co
VITE_API_BASE_URL=

# Optional UI overrides
# VITE_APP_NAME=HAWKTRACE
# VITE_ORG_NAME=NEHANDA Systems
